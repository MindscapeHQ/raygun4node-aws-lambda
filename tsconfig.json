{
  "compilerOptions": {
    "target": "es5",
    "ignoreDeprecations": "6.0",
    "module": "commonjs",
    "lib": ["es5", "es6"],
    "declaration": true,
    "outDir": "./build",
    "rootDir": "./lib",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["lib/**/*"]
}
